local function hasKeyword(name)
	local lower = string.lower(name)
	for i = 1, #KEYWORDS do
		if string.find(lower, KEYWORDS[i], 1, true) then return true end
	end
	return false
end

-- позиция камеры, актуальная на момент текущего скана ESP
local scanCamPos = Vector3.zero

local function getDistance(inst)
	local pos
	if inst:IsA("BasePart") then
		pos = inst.Position
	elseif inst:IsA("Model") then
		local ok, p = pcall(function() return inst:GetPivot().Position end)
		if not ok then return 99999 end
		pos = p
	else
		return 99999
	end
	return (pos - scanCamPos).Magnitude
end

