		Text = "",
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = Theme.Text,
		Parent = statusBar,
	})

	local lastStatusText = ""
	local function updateStatus()
		local aimState = aimbotEnabled and "ВКЛ" or "ВЫКЛ"
		local wallState = wallCheckEnabled and "ВКЛ" or "ВЫКЛ"
		local tgt = "нет"
		if currentTargetChar then
			local p = Players:GetPlayerFromCharacter(currentTargetChar)
			if p then tgt = p.Name end
		end
		local t
		if mouseUnlocked then
			t = "Aim: " .. aimState .. " | WallCheck: " .. wallState .. " | Цель: " .. tgt .. " | Мышь свободна (K)"
			statusLabel.TextColor3 = Theme.Warn
		else
			t = "Aim: " .. aimState .. " | WallCheck: " .. wallState .. " | Цель: " .. tgt .. " | K — мышь | RShift — меню"
			statusLabel.TextColor3 = Theme.Text
		end
		if t ~= lastStatusText then
			lastStatusText = t
			statusLabel.Text = t
		end
	end

	local function setMouseUnlocked(state)
		mouseUnlocked = state
		if not state then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		end
		updateStatus()
	end
	updateStatus()

	local function toggleMenu()
		menuVisible = not menuVisible
		win.Visible = menuVisible
		if menuVisible then
			winScale.Scale = 0.92
			tw(winScale, 0.2, {Scale = 1}, Enum.EasingStyle.Back)
		elseif mouseUnlocked then
			setMouseUnlocked(false)
		end
	end
	connect(minBtn.MouseButton1Click, toggleMenu)

	-- ===== Unload =====
	connect(unloadBtn.MouseButton1Click, function()
		unloaded = true
		speedEnabled = false
		applySpeed()
		if fullbrightEnabled then toggleFullbright(false) end
		aimbotEnabled = false
		currentTarget = nil
		currentTargetChar = nil
		pcall(function() RunService:UnbindFromRenderStep("HighDLC_Aimbot") end)
		if fovCircle then
			pcall(function() fovCircle:Remove() end)
			fovCircle = nil
		end
		for _, hl in ipairs(hlPool) do hl:Destroy() end
		for _, data in pairs(playerGuis) do if data and data.g then data.g:Destroy() end end
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		for _, c in ipairs(connections) do c:Disconnect() end
		gui:Destroy()
	end)

	-- ===== Клавиши =====
	connect(UserInputService.InputBegan, function(input, gameProcessed)
		if unloaded or gameProcessed then return end
		if input.KeyCode == UNLOCK_KEY then
			setMouseUnlocked(not mouseUnlocked)
		elseif input.KeyCode == HIDE_KEY then
			toggleMenu()
		end
	end)

	-- ===== Один общий RenderStepped: мышь + статус + индикатор цели =====
	local statusFrame = 0
	connect(RunService.RenderStepped, function()
		if unloaded then return end

		-- мышь
		if mouseUnlocked then
			UserInputService.MouseIconEnabled = true
			if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			end
		end

		-- статус-бар (раз в ~0.5с)
		statusFrame += 1
		if statusFrame % 30 == 0 then
			updateStatus()
		end

		-- индикатор цели
		local show = aimbotEnabled and currentTarget ~= nil and currentTargetChar ~= nil
		if not show then
			if indicatorVisible then
				indicatorVisible = false
				targetIndicator.Visible = false
			end
			return
		end

		local hum = currentTargetChar:FindFirstChildOfClass("Humanoid")
		local plr = Players:GetPlayerFromCharacter(currentTargetChar)
		if not plr or not hum or hum.Health <= 0 then
			if indicatorVisible then
				indicatorVisible = false
				targetIndicator.Visible = false
			end
			return
		end

		if not indicatorVisible then
			indicatorVisible = true
			targetIndicator.Visible = true
		end
		targetNameLabel.Text = plr.Name .. "  [" .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) .. "]"
		local hpPct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
		targetHPFill.Size = UDim2.new(hpPct, 0, 1, 0)
		targetHPFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - hpPct), 255 * hpPct, 0)
	end)
end

