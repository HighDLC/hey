	local function selectTab(tab)
		for _, t in ipairs(tabs) do
			local active = (t == tab)
			t.page.Visible = active
			tw(t.btn, 0.15, {BackgroundTransparency = active and 0 or 1})
			tw(t.indicator, 0.15, {BackgroundTransparency = active and 0 or 1})
			tw(t.label, 0.15, {TextColor3 = active and Theme.Text or Theme.SubText})
		end
		pageTitle.Text = tab.title
	end

	local tabEsp = addTab("ESP", "ESP", espPage, 1)
	local tabPlayer = addTab("ИГРОК", "Игрок", playerPage, 2)
	local tabVisual = addTab("ВИЗУАЛ", "Визуал", visualPage, 3)
	local tabAimbot = addTab("АИМБОТ", "Аимбот", aimbotPage, 4)
	for _, t in ipairs(tabs) do
		connect(t.btn.MouseButton1Click, function() selectTab(t) end)
