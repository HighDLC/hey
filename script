local function startCore()
	-- запоминаем стандартную скорость
	task.spawn(function()
		local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		local hum = char:WaitForChild("Humanoid", 10)
		if hum then
			defaultSpeed = hum.WalkSpeed
		end
	end)

	connect(LocalPlayer.CharacterAdded, function(char)
		char:WaitForChild("Humanoid")
		task.wait(0.1)
		if speedEnabled then applySpeed() end
	end)

	-- защита скорости
	connect(RunService.Heartbeat, function()
		if unloaded or not speedEnabled then return end
		local hum = getHumanoid()
		if hum and math.abs(hum.WalkSpeed - speedValue) > 0.1 then
			hum.WalkSpeed = speedValue
		end
	end)

	-- цикл ESP
	task.spawn(function()
		local targets = {}

		local function check(inst, depth)
			if depth > 3 then return end
			if inst:IsA("Model") then
				local plr = Players:GetPlayerFromCharacter(inst)
				local isTarget, isPlayer = false, false

				if plr then
					if plr ~= LocalPlayer then
						isTarget = true
						isPlayer = true
					end
				elseif hasKeyword(inst.Name) then
					isTarget = true
				end

				if isTarget then
					local dist = getDistance(inst)
					local maxDist = isPlayer and maxPlayerDist or maxItemDist
					if dist >= MIN_DISTANCE and dist <= maxDist then
						table.insert(targets, {inst = inst, dist = dist, isPlayer = isPlayer})
					end
				end
			elseif inst:IsA("BasePart") then
				if inst:FindFirstAncestorOfClass("Model") and hasKeyword(inst.Name) then
					local dist = getDistance(inst)
					if dist >= MIN_DISTANCE and dist <= maxItemDist then
						table.insert(targets, {inst = inst, dist = dist, isPlayer = false})
					end
				end
			end

			for _, child in ipairs(inst:GetChildren()) do check(child, depth + 1) end
		end

		while not unloaded do
			if espEnabled then
				local cam = Workspace.CurrentCamera
				scanCamPos = cam and cam.CFrame.Position or Vector3.zero

				targets = {}
				for _, child in ipairs(Workspace:GetChildren()) do check(child, 1) end
				table.sort(targets, function(a, b) return a.dist < b.dist end)

				for _, hl in ipairs(hlPool) do
					hl.Enabled = false
					hl.Adornee = nil
				end

				local activeCount = 0
				local activePlayers = {}

				for i = 1, #targets do
					if activeCount >= maxHighlights then break end
					local data = targets[i]

					if data.isPlayer then
						activePlayers[data.inst] = true
						updatePlayerGui(data.inst, data.dist)
					end

					local hl = getHighlight()
					hl.OutlineColor = espColor
					hl.FillColor = espColor
					hl.Adornee = data.inst
					hl.Enabled = true
					activeCount += 1
				end

				for char, data in pairs(playerGuis) do
					if not char.Parent then
						data.g:Destroy()
						playerGuis[char] = nil
					elseif not activePlayers[char] then
						data.g.Enabled = false
					end
				end
			else
				for _, hl in ipairs(hlPool) do hl.Enabled = false; hl.Adornee = nil end
				for _, data in pairs(playerGuis) do data.g.Enabled = false end
			end

			task.wait(SCAN_RATE)
		end
	end)

	-- ===== Aimbot: поворот камеры на цель каждый кадр =====
	-- BindToRenderStep с приоритетом ПОСЛЕ камеры, чтобы игра не перезаписывала наш CFrame.
	pcall(function() RunService:UnbindFromRenderStep("HighDLC_Aimbot") end)
	RunService:BindToRenderStep("HighDLC_Aimbot", Enum.RenderPriority.Camera.Value + 1, function()
		if unloaded then return end

		if not aimbotEnabled then
			currentTarget = nil
			currentTargetChar = nil
			if fovCircle then fovCircle.Visible = false end
			return
		end

		local cam = Workspace.CurrentCamera
		if not cam then
			currentTarget = nil
			currentTargetChar = nil
			return
		end

		local target, targetChar = getClosestTarget()
		currentTarget = target
		currentTargetChar = targetChar

		if target then
			local ok, targetPos = pcall(function() return target.Position end)
			if ok then
				-- поворачиваем камеру на цель (позицию камеры оставляем игре)
				local desired = CFrame.lookAt(cam.CFrame.Position, targetPos)
				if smoothnessValue > 0 then
					local alpha = 1 / (smoothnessValue + 1)
					cam.CFrame = cam.CFrame:Lerp(desired, alpha)
				else
					cam.CFrame = desired
				end
			else
				currentTarget = nil
				currentTargetChar = nil
			end
		end

		-- FOV-круг
		if fovCircle then
			fovCircle.Position = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)
			fovCircle.Radius = fovRadius
			fovCircle.Visible = true
		end
	end)

	fovCircle = createFOVCircle()
	notify("Aimbot (камера) готов", Theme.Good)
end

