	})
	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.new(0, 0, 0, 20),
		BackgroundTransparency = 1,
		Text = "HighDLC",
		Font = Enum.Font.GothamBlack,
		TextSize = 29,
		TextColor3 = Color3.new(1, 1, 1),
		Parent = titleArea,
	}, {gradient(Theme.Accent, Theme.Accent2, 0)})
	new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.new(0, 0, 0, 55),
		BackgroundTransparency = 1,
		Text = "Система ключей",
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = Theme.SubText,
		Parent = titleArea,
	})
	makeDraggable(win, titleArea)

	-- слово для копирования
	local copyBox = new("Frame", {
		Size = UDim2.new(1, -48, 0, 54),
		Position = UDim2.new(0, 24, 0, 92),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		Parent = win,
	}, {corner(10), stroke(Theme.Stroke, 1, 0.4)})
	new("TextLabel", {
		Size = UDim2.new(1, -130, 0, 14),
		Position = UDim2.new(0, 14, 0, 8),
		BackgroundTransparency = 1,
		Text = "Слово для копирования",
		Font = Enum.Font.Gotham,
		TextSize = 10,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = copyBox,
	})
	new("TextLabel", {
		Size = UDim2.new(1, -130, 0, 24),
		Position = UDim2.new(0, 14, 0, 23),
		BackgroundTransparency = 1,
		Text = COPY_TEXT,
		Font = Enum.Font.Code,
		TextSize = 18,
		TextColor3 = Theme.Accent2,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = copyBox,
	})
	local copyBtn = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Size = UDim2.new(0, 104, 0, 34),
		Position = UDim2.new(1, -10, 0.5, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "Копировать",
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = Color3.new(1, 1, 1),
		Parent = copyBox,
	}, {corner(8)})
	hoverable(copyBtn, Theme.Accent, Color3.fromRGB(150, 122, 255))

	connect(copyBtn.MouseButton1Click, function()
		local ok = copyToClipboard(COPY_TEXT)
		if ok then
			copyBtn.Text = "Скопировано!"
			notify("Скопировано: " .. COPY_TEXT, Theme.Good)
			task.delay(1.5, function()
				if copyBtn.Parent then copyBtn.Text = "Копировать" end
			end)
		else
			notify("Буфер обмена недоступен в вашем экзекуторе", Theme.Warn)
		end
	end)

	-- поле ввода ключа
	local boxStroke = stroke(Theme.Stroke, 1, 0)
	local keyBox = new("TextBox", {
		Size = UDim2.new(1, -48, 0, 42),
		Position = UDim2.new(0, 24, 0, 162),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		Text = "",
		PlaceholderText = "Введите ключ...",
		PlaceholderColor3 = Theme.SubText,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextColor3 = Theme.Text,
		ClearTextOnFocus = false,
		Parent = win,
	}, {corner(10), boxStroke})

	connect(keyBox.Focused, function() tw(boxStroke, 0.15, {Color = Theme.Accent}) end)
	connect(keyBox.FocusLost, function() tw(boxStroke, 0.15, {Color = Theme.Stroke}) end)

	-- фон кнопки с градиентом
	local submitBg = new("Frame", {
		Size = UDim2.new(1, -48, 0, 42),
		Position = UDim2.new(0, 24, 0, 216),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 1,
		Parent = win,
	}, {corner(10), gradient(Theme.Accent, Theme.Accent2, 0)})

	local submitBtn = new("TextButton", {
		Size = UDim2.new(1, -48, 0, 42),
		Position = UDim2.new(0, 24, 0, 216),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "Проверить ключ",
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = 2,
		Parent = win,
	})
	connect(submitBtn.MouseEnter, function() tw(submitBg, 0.12, {BackgroundTransparency = 0.12}) end)
	connect(submitBtn.MouseLeave, function() tw(submitBg, 0.12, {BackgroundTransparency = 0}) end)

	local statusLabel = new("TextLabel", {
		Size = UDim2.new(1, -48, 0, 18),
		Position = UDim2.new(0, 24, 0, 266),
		BackgroundTransparency = 1,
		Text = "",
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = Theme.SubText,
		Parent = win,
	})

	local tgSmall = new("TextButton", {
		Size = UDim2.new(1, -48, 0, 30),
		Position = UDim2.new(0, 24, 0, 292),
		BackgroundColor3 = Theme.Element,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "Telegram разработчика — " .. TG_NAME,
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextColor3 = Theme.Telegram,
		Parent = win,
	}, {corner(8)})
	hoverable(tgSmall, Theme.Element, Theme.ElementHover)
	connect(tgSmall.MouseButton1Click, function() telegramCard.Toggle() end)

	-- проверка ключа
	local busy = false
	local function shake()
		local base = win.Position
		for i = 1, 6 do
			local off = (i % 2 == 0) and 8 or -8
			win.Position = UDim2.new(base.X.Scale, base.X.Offset + off, base.Y.Scale, base.Y.Offset)
			task.wait(0.04)
		end
		win.Position = base
	end

	local function submit()
		if busy then return end
		local entered = string.match(keyBox.Text, "^%s*(.-)%s*$")

		if entered == "" then
			statusLabel.Text = "Введите ключ"
			statusLabel.TextColor3 = Theme.Warn
			return
		end

		if entered == CORRECT_KEY then
			busy = true
			statusLabel.Text = "Ключ верный! Загрузка..."
			statusLabel.TextColor3 = Theme.Good
			tw(boxStroke, 0.15, {Color = Theme.Good})
			notify("Доступ разрешён", Theme.Good)
			task.wait(0.5)
			tw(backdrop, 0.3, {BackgroundTransparency = 1})
			tw(scale, 0.3, {Scale = 0.8}, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			task.wait(0.32)
			backdrop:Destroy()
			onSuccess()
		else
			busy = true
			statusLabel.Text = "Неверный ключ"
			statusLabel.TextColor3 = Theme.Bad
			tw(boxStroke, 0.15, {Color = Theme.Bad})
			shake()
			task.wait(0.4)
			tw(boxStroke, 0.2, {Color = Theme.Stroke})
			busy = false
		end
	end

	connect(submitBtn.MouseButton1Click, submit)
	connect(keyBox.FocusLost, function(enterPressed)
		if enterPressed then submit() end
	end)
end

