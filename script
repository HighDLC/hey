-- проверка: один ли мы тим с игроком
local function isSameTeam(player)
	if not LocalPlayer.Team or not player.Team then return false end
	return LocalPlayer.Team == player.Team
end

-- один общий RaycastParams + таблица фильтра (без аллокаций на каждый кадр)
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local rayFilter = {}
rayParams.FilterDescendantsInstances = rayFilter

-- проверка видимости через Raycast (wall check)
local function isTargetVisible(targetPart, camPos)
	local partPos = targetPart.Position
	local direction = partPos - camPos

	rayFilter[1] = LocalPlayer.Character
	rayParams.FilterDescendantsInstances = rayFilter

	local result = Workspace:Raycast(camPos, direction, rayParams)
	if not result then return true end -- линия чистая

	-- попали в часть персонажа цели — значит видно
	local targetChar = targetPart:FindFirstAncestorOfClass("Model")
	if targetChar and (result.Instance:IsDescendantOf(targetChar) or result.Instance == targetPart) then
		return true
	end
	return false
end

-- поиск ближайшей цели в FOV.
-- Два прохода: дешёвый FOV-скрининг, затем рейкаст только до первой видимой цели.
local function getClosestTarget()
	local cam = Workspace.CurrentCamera
	if not cam then return nil end
	local camPos = cam.CFrame.Position
	local viewSize = cam.ViewportSize
	local centerX = viewSize.X * 0.5
	local centerY = viewSize.Y * 0.5
	local fov2 = fovRadius * fovRadius

	local cands = {}
	local n = 0

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		local char = player.Character
		if not char then continue end
		if teamCheckEnabled and isSameTeam(player) then continue end

		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then continue end

		local part = char:FindFirstChild(targetPartName)
		if not part and targetPartName == "Torso" then
			part = char:FindFirstChild("UpperTorso")
		end
		if not part then continue end

		local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
		if not onScreen then continue end
		local dx = screenPos.X - centerX
		local dy = screenPos.Y - centerY
		local d2 = dx * dx + dy * dy
		if d2 > fov2 then continue end

		n += 1
		cands[n] = {part = part, char = char, d2 = d2}
	end

	if n == 0 then return nil end

	table.sort(cands, function(a, b) return a.d2 < b.d2 end)

	if wallCheckEnabled then
		for i = 1, n do
			local c = cands[i]
			if isTargetVisible(c.part, camPos) then
				return c.part, c.char
			end
		end
		return nil
	end

	return cands[1].part, cands[1].char
end

-- создание FOV-круга через Drawing API
local function createFOVCircle()
	local ok, circle = pcall(function()
		local c = Drawing.new("Circle")
		c.Thickness = 1.5
		c.Radius = fovRadius
		c.NumSides = 64
		c.Filled = false
		c.Color = Color3.fromRGB(255, 255, 255)
		c.Transparency = 0.6
		c.Visible = false
		return c
	end)
	if ok then return circle end
	return nil
end

